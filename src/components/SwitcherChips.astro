---
interface Chip {
  label: string;
  href: string;
  active: boolean;
}

interface Props {
  label: string;
  chips: Chip[];
}

const { label, chips } = Astro.props;
---

{chips.length > 0 && (
  <div class="switcher-row">
    <span class="switcher-label">{label}</span>
    <div class="switcher-scroll">
      {chips.map(chip => (
        chip.active ? (
          <span class="switcher-chip active" aria-current="page">{chip.label}</span>
        ) : (
          <a href={chip.href} class="switcher-chip">{chip.label}</a>
        )
      ))}
    </div>
  </div>
)}

<style>
  .switcher-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    min-width: 0;
  }

  .switcher-label {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-light);
    white-space: nowrap;
  }

  .switcher-scroll {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    min-width: 0;
  }
  .switcher-scroll::-webkit-scrollbar { display: none; }

  .switcher-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-border);
    background: var(--color-bg);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }
  a.switcher-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
  }
  .switcher-chip.active {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: white;
    font-weight: var(--font-weight-semibold);
  }
</style>
