---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GiftCard from '../../components/GiftCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubSelector from '../../components/HubSelector.astro';
import { getGiftGuides } from '../../lib/notion';

export const getStaticPaths = async () => {
  const guides = await getGiftGuides();
  const budgets = [...new Set(guides.flatMap(g => g.budgetTag))].filter(Boolean);
  return budgets.map(budget => ({
    params: { budget },
    props: {
      budget,
      guides: guides.filter(g => g.budgetTag.includes(budget)),
    },
  }));
};

const { budget, guides } = Astro.props;

const quickRelations = [...new Set(guides.flatMap(g => g.relation))].filter(Boolean);

const breadcrumbs = [
  { label: '홈', href: '/' },
  { label: '예산별 선물', href: '/예산/' },
  { label: `${budget} 선물`, href: '' },
];
---

<BaseLayout
  title={`${budget} 선물 추천 가이드 — 선물추천 가이드`}
  description={`예산 ${budget}으로 살 수 있는 선물 추천 가이드 ${guides.length}개. 실제 구매자 후기 기반 선물 추천.`}
>
  <Header />

  <main class="container" style="padding-top:var(--space-10);padding-bottom:var(--space-16)">
    <CategoryNav activeHref="/예산/" />
    <Breadcrumb items={breadcrumbs} />

    <header class="page-header">
      <h1 class="page-title">
        {budget} <span class="title-sub">선물 추천 가이드</span>
      </h1>
      <p class="page-desc">{guides.length}개 가이드에서 예산 {budget}에 맞는 선물을 찾아보세요.</p>
    </header>

    {guides.length > 0 ? (
      <Fragment>
        <HubSelector guides={guides} mode="budget" />

        {budget === '5만원이하' && (
          <Fragment>
            <section class="hub-extra" aria-labelledby="quick-relation-title">
              <h2 id="quick-relation-title" class="hub-extra-title">
                <i class="ti ti-heart" aria-hidden="true"></i>
                관계별 빠른 링크
              </h2>
              <div class="quick-relation-list">
                {quickRelations.map(r => (
                  <a href={`/관계/${r}/`} class="quick-relation-pill">{r}</a>
                ))}
              </div>
            </section>

            <section class="hub-extra" aria-labelledby="fail-box-title">
              <h2 id="fail-box-title" class="hub-extra-title">
                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                이럴 땐 피하세요
              </h2>
              <ul class="fail-box-list">
                <li><strong>사이즈를 모르면</strong> — 의류·신발은 피하고, 액세서리·상품권처럼 사이즈와 무관한 카테고리를 고르세요.</li>
                <li><strong>취향을 잘 모르면</strong> — 5만원 이하에서는 개인화 부담이 큰 상품보다 상품권·실용템으로 시작하는 편이 안전합니다.</li>
                <li><strong>여러 명에게 각각 줄 선물이라면</strong> — 문구·소품처럼 취향 영향이 적고 여러 개 구매하기 좋은 카테고리를 비교하세요.</li>
              </ul>
            </section>

            <section class="hub-extra" aria-labelledby="compare-table-title">
              <h2 id="compare-table-title" class="hub-extra-title">
                <i class="ti ti-table" aria-hidden="true"></i>
                카테고리 비교
              </h2>
              <div class="compare-table-wrap">
                <table class="compare-table">
                  <thead>
                    <tr><th>카테고리</th><th>무난함</th><th>개인화 필요도</th><th>교환 필요성</th><th>급한 구매 적합성</th></tr>
                  </thead>
                  <tbody>
                    <tr><td>상품권·기프트카드</td><td>상</td><td>하</td><td>낮음</td><td>상</td></tr>
                    <tr><td>문구·소품</td><td>상</td><td>하</td><td>낮음</td><td>상</td></tr>
                    <tr><td>액세서리</td><td>중</td><td>중</td><td>낮음~중간</td><td>중</td></tr>
                    <tr><td>뷰티·코스메</td><td>중</td><td>중~상</td><td>낮음~중간</td><td>중</td></tr>
                    <tr><td>취미 용품</td><td>하</td><td>상</td><td>중간</td><td>중</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="compare-table-note">5만원 이하에서는 개인화 필요도가 낮은 카테고리일수록 실패 없이 고르기 쉽습니다.</p>
            </section>
          </Fragment>
        )}

        <div class="guide-grid">
          {guides.map(guide => <GiftCard guide={guide} />)}
        </div>
      </Fragment>
    ) : (
      <div class="empty-state">
        <i class="ti ti-gift-off" aria-hidden="true"></i>
        <p>준비 중입니다. 곧 업데이트될 예정이에요.</p>
        <a href="/예산/" class="btn btn-outline">다른 예산 보기</a>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-8); }
  .page-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--font-weight-bold); margin-bottom: var(--space-3);
  }
  .title-sub { color: var(--color-text-muted); font-weight: var(--font-weight-medium); }
  .page-desc { font-size: var(--text-lg); color: var(--color-text-muted); }

  .guide-grid {
    display: grid; grid-template-columns: 1fr; gap: var(--space-5);
  }
  @media (min-width: 480px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .empty-state {
    text-align: center; padding: var(--space-16) 0;
    display: flex; flex-direction: column; align-items: center; gap: var(--space-4);
  }
  .empty-state i { font-size: 3rem; color: var(--color-text-light); }
  .empty-state p { font-size: var(--text-lg); color: var(--color-text-muted); }

  .hub-extra { margin-bottom: var(--space-8); }
  .hub-extra-title {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-lg); font-weight: var(--font-weight-bold);
    color: var(--color-text); margin-bottom: var(--space-4);
  }

  .quick-relation-list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .quick-relation-pill {
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-subtle); border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full); color: var(--color-text);
    font-size: var(--text-sm); text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .quick-relation-pill:hover { border-color: var(--color-primary); background: var(--color-primary-light); }

  .fail-box-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .fail-box-list li {
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-subtle); border-radius: var(--radius-md);
    font-size: var(--text-sm); color: var(--color-text);
  }
  .fail-box-list strong { color: var(--color-primary-dark); }

  .compare-table-wrap { overflow-x: auto; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .compare-table th, .compare-table td {
    padding: var(--space-2) var(--space-3); text-align: left;
    border-bottom: 1px solid var(--color-border-subtle); white-space: nowrap;
  }
  .compare-table th { color: var(--color-text-muted); font-weight: var(--font-weight-semibold); }
  .compare-table-note { margin-top: var(--space-3); font-size: var(--text-xs); color: var(--color-text-muted); }
</style>
